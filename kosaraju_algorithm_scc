strongly connect component:
1.kosaraju algorithm
->step->toposort by dfs
->reverse graph
->pop element from stack one by one and again dfs for vis
#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> g, rg;
void toposort(int u, vector<int> &visit, stack<int> &st) {
    visit[u] = 1;
    for (int v : g[u]) {
        if (!visit[v])
            toposort(v, visit, st);
    }
    st.push(u);
}

void dfs(int u, vector<int> &visit, vector<int> &comp) {
    visit[u] = 1;
    comp.push_back(u);
    for (int v : rg[u]) {
        if (!visit[v])
            dfs(v, visit, comp);
    }
}

void solve() {
    int n, m;
    cin >> n >> m;

    g.assign(n + 1, {});
    rg.assign(n + 1, {});

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        g[u].push_back(v);
        rg[v].push_back(u);
    }

    vector<int> visit(n + 1, 0);
    stack<int> st;

    // 1) order by finish time
    for (int i = 1; i <= n; i++) {
        if (!visit[i])
            toposort(i, visit, st);
    }

    fill(visit.begin(), visit.end(), 0);

    vector<int> comp_id(n + 1, 0);
    int k = 0;

    // 2) pop node one by one
    while (!st.empty()) {
        int u = st.top();
        st.pop();

        if (!visit[u]) {
            ++k;
            vector<int> comp;
            dfs(u, visit, comp);

            for (int x : comp)
                comp_id[x] = k;
        }
    }

    cout << k << "\n";
    for (int i = 1; i <= n; i++)
        cout << comp_id[i] << " ";
    cout << "\n";
}

int main() {
    solve();
}
